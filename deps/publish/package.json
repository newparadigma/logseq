{
  "name": "@logseq/publish",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "scripts": {
    "dev": "cd ./worker && pnpm exec wrangler dev",
    "watch": "clojure -M:cljs watch publish-worker",
    "release": "clojure -M:cljs release publish-worker",
    "build:node": "clojure -M:cljs release publish-node",
    "build:static": "node ./scripts/build-static.js",
    "start:node": "node worker/dist/node-server.js",
    "test": "clojure -M:cljs compile publish-test && node worker/dist/worker-test.js",
    "clean": "rm -rf ./worker/dist/",
    "bump-publish-version": "node ./scripts/bump-publish-version.js"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "better-sqlite3": "^12.8.0",
    "codemirror": "5.65.18",
    "inter-ui": "^4.1.1",
    "katex": "^0.16.45",
    "mldoc": "^1.5.9",
    "shadow-cljs": "^3.4.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
