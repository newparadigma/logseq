# Domain that points to this server (A/AAAA record). Caddy gets the
# HTTPS certificate for it automatically; ports 80 and 443 must be open.
PUBLISH_DOMAIN=publish.example.com

# Published pages and their assets. Keep them outside the repository
# checkout, so that `git clean` or a new clone cannot delete them.
DATA_DIR=/srv/logseq-publish/data

# Owner of the files in DATA_DIR (run `id -u` and `id -g` on the host).
PUID=1000
PGID=1000

# Who may publish: the same 3 lines as in the sync server .env, so the
# token you signed in with in the app also publishes. Print them with:
#   node deps/db-sync/scripts/selfhost-token.mjs env ~/logseq-sync-auth
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_JWKS_URL=
